@startuml P110_register_tas_simple

'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
' Settings
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
'=== Header and Footer ===
header OPEN-DID Technical Specification
footer
  	Page %page% of %lastpage% at %date("yyyy-MM-dd hh:mm:ss")
end footer

'=== Title ===
title
	<size:25>P110: TA Registration</size>
end title

'=== Options ===
autonumber "<b>(#)</b>"

'=== Participants ===
<style>
participant {
  Padding 20
}
</style>
skinparam BoxPadding 20
skinparam MaxMessageSize 500
skinparam MinClassWidth 80

box TA Admin
    actor "**TA Admin**" as ADMIN #WhiteSmoke
end box

box TA Provider #AliceBlue
    participant "**TA**" as TA <<WAS>> #WhiteSmoke
end box


box Trusted Storage
    participant "**blockchain**" as BC <<Storage>> #WhiteSmoke
end box 
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
' Constants
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

!$refdoc = "Refer to separate document"


'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
' Content
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
||| 

== TA DID Document Registration  ==
rnote across #white
    TA DID Document registration is not covered in this specification.
end note

||| 

== P110: TA Registration ==
ADMIN -> TA++: TA Registration Request
rnote right of ADMIN #Lavender        
    **[M110_REQ: TA Registration Request]**
end note

TA -> TA: Create TA Membership Certificate VC
TA -> BC: Register Membership Certificate VC Metadata

TA --> ADMIN--: TA Registration Response
rnote right of ADMIN #Lavender        
    **[M110_RES: TA Registration Response]**
end note

|||
|||
@enduml
