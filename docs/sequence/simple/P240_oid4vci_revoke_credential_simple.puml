@startuml P240_oid4vci_revoke_credential_simple

'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
' Settings
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
'=== Header and Footer ===
header OPEN-DID Technical Specification
footer
  	Page %page% of %lastpage% at %date("yyyy-MM-dd hh:mm:ss")
end footer

'=== Title ===
title
	<size:25>P240 : OID4VCI Credential Revocation</size>
end title

'=== Options ===
autonumber "<b>(#)</b>"

'=== Panticipants ===
skinparam ParticipantPadding 20
skinparam BoxPadding 20
skinparam MaxMessageSize 500
skinparam MinClassWidth 80


actor USER

box Mobile #OldLace
    participant "**Wallet**" as WALLET <<Wallet>> #WhiteSmoke
end box

box Issuing Provider #AliceBlue
    participant "**Credential Issuer**" as CI <<Server>> #WhiteSmoke
end box

box Verifier #AliceBlue
    participant "**Verifier**" as VERIFIER <<Server>> #WhiteSmoke
end box

box Trusted Storage
    participant "**blockchain**" as BC <<Storage>> #WhiteSmoke
end box


'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
' Constants
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

!$refdoc = "Refer to separate document"
!$doc = "Refer to data specification document"

'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
' Content
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
|||

rnote over WALLET, CI
    OpenDID OID4VCI extension API (no Access Token, no TAS)
end rnote

== P240-1 : Request c_nonce ==
USER -> WALLET: Request Credential revocation
activate WALLET
USER -[#Blue]\ WALLET: User authentication (non-standard)
WALLET -> CI++: c_nonce request
    rnote right of WALLET #Lavender
        **[M240_REQ : c_nonce request]**
    end note
return c_nonce response
rnote right of WALLET #Lavender
    **[M240_RES : c_nonce response]**
end note

== P240-2 : Create Revocation Token ==
WALLET -> WALLET: Generate Revocation Token
WALLET -> WALLET: Sign with the Holder DID key

== P240-3 : Request Credential Revocation ==
WALLET -> CI++: Credential revocation request
    rnote right of WALLET #Lavender
        **[M240_REQ : Credential revocation request]**
    end note
    CI <-> BC: Retrieve Holder DID Document
    CI -> CI: Verify token and signature, verify owner
    CI -> CI: Change status to INVALID
return Credential revocation response
rnote right of WALLET #Lavender
    **[M240_RES : Credential revocation response]**
end note
WALLET -> WALLET: Delete the Credential
deactivate WALLET

== P240-4 : Check Status (Optional) ==
VERIFIER -> CI++: Retrieve Status List request
    rnote right of VERIFIER #Lavender
        **[M240_REQ : Retrieve Status List request]**
    end note
return Status List Token response
rnote right of VERIFIER #Lavender
    **[M240_RES : Status List Token response]**
end note
VERIFIER -> VERIFIER: Check the status value at the idx position

@enduml
