@startuml P110_register_tas

'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
' Settings
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
'=== Header and Footer ===
header OPEN-DID Technical Specification
footer
  	Page %page% of %lastpage% at %date("yyyy-MM-dd hh:mm:ss")
end footer

'=== Title ===
title
	<size:25>P110: TA Registration</size>
end title

'=== Options ===
autonumber "<b>(#)</b>"

'=== Participants ===
<style>
participant {
  Padding 20
}
</style>
skinparam BoxPadding 20
skinparam MaxMessageSize 500
skinparam MinClassWidth 80

box TA Admin
    actor "**TA Admin**" as ADMIN #WhiteSmoke
end box

box TA Provider #AliceBlue
    participant "**TA**" as TA <<WAS>> #WhiteSmoke
end box


box Trusted Storage
    participant "**blockchain**" as BC <<Storage>> #WhiteSmoke
end box 
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
' Constants
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

!$refdoc = "Refer to separate document"
!$doc = "Refer to data specification document"


'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
' Content
'- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
||| 

== TA DID Document Registration  ==
rnote across #white
    TA DID Document registration is not covered in this specification.
end note

||| 

== P110: TA Registration ==
rnote across #white
    The TA Admin must have received the password in advance.
end note
ADMIN -> TA++: TA Registration Request
rnote right of ADMIN #LightGray        
    **[M110_REQ : TA Registration Request]**
    body : 
        messageId
        password
end note

    TA -> TA: vc: Issue Membership Certificate VC
    rnote right of TA #MintCream
        **Membership Certificate VC**: $refdoc
    end note

    TA -> TA: vcMeta: Generate metadata for Membership Certificate VC
    rnote right of TA #MintCream
        **vcMeta** : $doc
    end note

    TA -> TA: Publish Membership Certificate VC\
            \n* certVcRef = Membership Certificate VC URL

    TA -> BC++ : Register vcMeta {vcMeta}
    return OK

return TA Registration Response
rnote right of ADMIN #LightGray        
    **[M110_RES : TA Registration Response]**
    body : 
        certVcRef
end note

||| 
||| 
@enduml
