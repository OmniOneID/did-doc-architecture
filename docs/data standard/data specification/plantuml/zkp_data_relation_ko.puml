@startuml zkp_data_relation_ko

'=== 설정 ===
skinparam defaultFontName Arial
skinparam shadowing false
skinparam ArrowColor #333333
skinparam ArrowFontSize 12
skinparam class {
    BorderColor #555555
    FontSize 13
    AttributeFontSize 12
}
skinparam package {
    BorderColor #888888
    FontSize 13
}
skinparam nodesep 40
skinparam ranksep 60
hide circle
hide methods
hide empty members

package "신뢰저장소" #F7F7F7 {
    class CredentialSchema #AliceBlue {
        {field} id
        {field} name, version
        {field} attrNames, attrTypes
    }
    class CredentialDefinition #AliceBlue {
        {field} id
        {field} schemaId
        {field} ver, type, value
    }
}

package "발급" #FFFFFF {
    class CredentialOffer #OldLace {
        {field} nonce
        {field} schemaId, credDefId
        {field} keyCorrectnessProof
    }
    class CredentialRequest #OldLace {
        {field} credDefId
        {field} nonce
        {field} blindedMs
        {field} blindedMsCorrectnessProof
    }
    class Credential #OldLace {
        {field} credentialId
        {field} schemaId, credDefId
        {field} values
        {field} signature
        {field} signatureCorrectnessProof
    }
}

package "제출" #FFFFFF {
    class ProofRequest #Honeydew {
        {field} name
        {field} nonce
        {field} requestedAttributes[].restrictions
        {field} requestedPredicates[].restrictions
    }
    class Proof #Honeydew {
        {field} proofs
        {field} aggregatedProof
        {field} requestedProof
        {field} identifiers[].schemaId, credDefId
    }
}

CredentialSchema <-down- CredentialDefinition : schemaId
CredentialDefinition <-down- CredentialOffer : credDefId
CredentialDefinition <-down- CredentialRequest : credDefId
CredentialDefinition <-down- Credential : credDefId
CredentialDefinition <-down- ProofRequest : restrictions\n(credDefId)
CredentialDefinition <-down- Proof : identifiers\n(credDefId)
CredentialOffer .right.> CredentialRequest : nonce
CredentialRequest .right.> Credential : 발급
ProofRequest .right.> Proof : 요청 속성\n/ 조건
Credential .down.> Proof : 생성 근거

note bottom of 제출
    CredentialOffer, Credential, Proof(identifiers)는
    CredentialSchema의 schemaId도 함께 포함한다.
end note

@enduml
