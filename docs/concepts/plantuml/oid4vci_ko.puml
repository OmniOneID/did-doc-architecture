@startuml oid4vci_seq_revocation_ko
autonumber "<b>(#)</b>"
skinparam ParticipantPadding 20
skinparam BoxPadding 20
skinparam MaxMessageSize 400

actor "**사용자**" as user
participant "**월렛**" as wal <<Wallet>>
participant "**Credential Issuer**" as ci <<Server>>
participant "**신뢰저장소**" as repo <<Storage>>

user -> wal: Credential 폐기 요청
wal -> ci ++: POST Nonce
return {c_nonce}
wal -> wal: Revocation Token 생성 및 서명\n* header{alg = ES256, typ = opendid-credential-revocation+jwt,\n         kid = Holder DID URL}\n* payload{iss = Holder DID, iat, exp, nonce,\n          credential_status.status_list{uri, idx}}
wal -> ci ++: POST credential_revocation_endpoint\n{revocation_token}
    ci -> repo: Holder DID Document 조회
    ci -> ci: 서명 및 Claim 검증
    ci -> ci: 발급 기록 조회 (status_list uri + idx)\n* ISSUED 상태 확인\n* subject_did = iss 확인
    ci -> ci: c_nonce 일회성 소비
    ci -> ci: 상태 INVALID 변경\n* Status List 갱신\n* 변경 이력 기록 (USER_REQUEST)
return {credential_status{status_list, status = INVALID}, revoked_at}
@enduml
