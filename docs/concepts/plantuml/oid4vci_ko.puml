@startuml oid4vci_state_credential_status_ko
!pragma layout smetana
hide empty description
state VALID: 유효 (0)
state SUSPENDED: 정지 (2)
state INVALID: 폐기 (1)

[*] --> VALID : 발급
VALID --> SUSPENDED : 관리자 정지
SUSPENDED --> VALID : 관리자 정지 해제
VALID --> INVALID : 관리자 폐기\n또는 월렛 폐기 요청
SUSPENDED --> INVALID : 관리자 폐기\n또는 월렛 폐기 요청
INVALID --> [*]
@enduml

