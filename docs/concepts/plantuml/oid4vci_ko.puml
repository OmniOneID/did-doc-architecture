@startuml oid4vci_components_ko
!pragma layout smetana
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam padding 4

actor "사용자" as user
component "월렛\n(Wallet)" as wallet
component "TAS\n(List Provider)" as tas

rectangle "발급 사업자 (Issuer 서버)" {
    component "Webview 발급\n(사용자 주도)" as web
    component "Authorization Server\n(내장)\n- Token / Authorize" as as
    component "Credential Issuer\n- Credential Offer\n- Credential / Nonce\n- Credential 폐기" as ci
    component "Status List\nEndpoint" as sl
    component "Admin Console" as admin
}

database "신뢰저장소\n(DID Document)" as repo
component "검증 사업자\n(Verifier)" as verifier

user -right-> wallet
wallet -right-> tas : Issuer 목록 조회
wallet --> web : 발급 시작\n(User Initiation URI)
wallet --> as : Access Token 발급
wallet --> ci : Credential 발급·폐기
admin -up-> tas : Issuer 등록 요청
' 라벨 앞의 \n\n은 곡선 화살표와 라벨이 겹치지 않게 한다 (smetana layout)
admin -left-> ci : \n\nMetadata·Configuration 설정
ci --> repo : Holder DID Document 조회
verifier -up-> sl : 상태 확인
@enduml

