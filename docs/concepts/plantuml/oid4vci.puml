@startuml oid4vci_state_credential_status
!pragma layout smetana
hide empty description
state VALID: Valid (0)
state SUSPENDED: Suspended (2)
state INVALID: Revoked (1)

[*] --> VALID : Issuance
VALID --> SUSPENDED : Suspended by administrator
SUSPENDED --> VALID : Suspension lifted by administrator
VALID --> INVALID : Revoked by administrator\nor wallet revocation request
SUSPENDED --> INVALID : Revoked by administrator\nor wallet revocation request
INVALID --> [*]
@enduml

'--------------------------------------------------------------------------------

@startuml oid4vci_seq_revocation
autonumber "<b>(#)</b>"
skinparam ParticipantPadding 20
skinparam BoxPadding 20
skinparam MaxMessageSize 400

actor "**User**" as user
participant "**Wallet**" as wal <<Wallet>>
participant "**Credential Issuer**" as ci <<Server>>
participant "**Trust Repository**" as repo <<Storage>>

user -> wal: Request Credential revocation
wal -> ci ++: POST Nonce
return {c_nonce}
wal -> wal: Generate and sign Revocation Token\n* header{alg = ES256, typ = opendid-credential-revocation+jwt,\n         kid = Holder DID URL}\n* payload{iss = Holder DID, iat, exp, nonce,\n          credential_status.status_list{uri, idx}}
wal -> ci ++: POST credential_revocation_endpoint\n{revocation_token}
    ci -> repo: Retrieve Holder DID Document
    ci -> ci: Verify signature and Claims
    ci -> ci: Retrieve issuance record (status_list uri + idx)\n* Check ISSUED status\n* Check subject_did = iss
    ci -> ci: Consume c_nonce (one-time use)
    ci -> ci: Change status to INVALID\n* Update Status List\n* Record change history (USER_REQUEST)
return {credential_status{status_list, status = INVALID}, revoked_at}
@enduml
